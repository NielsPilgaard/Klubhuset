# API — production environment variables
# Copy relevant lines to your deployment platform (Docker, Coolify, systemd EnvironmentFile, etc.)
# Never commit the real .env file with actual secrets.
# See docs/DEPLOYMENT.md for full documentation of every variable.

# ── Database ──────────────────────────────────────────────────────────────────
ConnectionStrings__DefaultConnection=Host=db;Database=skoleplanen;Username=app;Password=CHANGE_ME

# ── Keycloak ──────────────────────────────────────────────────────────────────
Keycloak__Authority=https://auth.skoleplanen.dk/realms/Skoleplanen
Keycloak__AdminClientId=skoleplanen-admin
Keycloak__AdminClientSecret=CHANGE_ME

# ── Object storage (OVHCloud S3-compatible) ───────────────────────────────────
ObjectStorage__ServiceUrl=https://s3.rbx.io.cloud.ovh.net/
ObjectStorage__DefaultBucketName=skoleplanen
ObjectStorage__PublicEndpoint=https://s3.rbx.io.cloud.ovh.net
ObjectStorage__AccessKey=CHANGE_ME
ObjectStorage__SecretKey=CHANGE_ME

# ── Presigned upload token signing ───────────────────────────────────────────
# Generate: openssl rand -base64 32
PresignedUpload__SigningKey=CHANGE_ME

# ── Stripe ────────────────────────────────────────────────────────────────────
Stripe__SecretKey=sk_live_CHANGE_ME
Stripe__WebhookSecret=whsec_CHANGE_ME
Stripe__PriceId=price_CHANGE_ME

# ── Email (Scaleway TEM) ──────────────────────────────────────────────────────
Smtp__Host=smtp.tem.scaleway.com
Smtp__Port=587
Smtp__FromAddress=kontakt@skoleplanen.dk
Smtp__FromName=Skoleplanen
