# Frontend — build-time environment variables (baked into the JS bundle by Vite)
# Set these in your CI/CD pipeline before running: npm run build
# See docs/DEPLOYMENT.md for full documentation.

# Keycloak base URL — no trailing slash, no realm path
# Dev default:  http://localhost:8080
# Production:   https://auth.skoleoverblikket.dk
VITE_KEYCLOAK_URL=http://localhost:8080
