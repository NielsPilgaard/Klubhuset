  "components": {
    "schemas": {
      "CreateSchemaRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "StaffRole": {
        "enum": [
          0,
          1,
          2
        ],
        "type": "integer",
        "format": "int32"
      },
      "UpsertBreakRequest": {
        "type": "object",
        "properties": {
          "startTime": {
            "type": "string",
            "format": "time"
          },
          "durationMinutes": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "UpsertClassRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "UpsertCourseRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "UpsertRoomRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "capacity": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "UpsertSlotRequest": {
        "type": "object",
        "properties": {
          "timeSlotId": {
            "type": "string",
            "format": "uuid"
          },
          "weekday": {
            "type": "integer",
            "format": "int32"
          },
          "courseId": {
            "type": "string",
            "format": "uuid"
          },
          "teacherId": {
            "type": "string",
            "format": "uuid"
          },
          "roomId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "aideId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "UpsertStaffRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "phone": {
            "type": "string",
            "nullable": true
          },
          "role": {
            "$ref": "#/components/schemas/StaffRole"
          }
        },
        "additionalProperties": false
      },
      "UpsertTemplateRequest": {
        "type": "object",
        "properties": {
          "lessonDurationMinutes": {
            "type": "integer",
            "format": "int32"
          },
          "dayStartTime": {
            "type": "string",
            "format": "time"
          },
          "dayEndTime": {
            "type": "string",
            "format": "time"
          },
          "activeDays": {
            "type": "string",
            "nullable": true
          },
          "breaks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UpsertBreakRequest"
            },
            "nullable": true
          }
        },
